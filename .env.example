# Django
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Canonical public origin embedded in printed pre-registration QR codes
# (external phone cameras open the live status page directly).
# Leave blank for local dev — QRs then use host-independent ABTC-PRE-REG tokens
# resolved by the in-app scanner, which works on localhost, LAN and production.
# Production example: SITE_URL=https://your-app.onrender.com
# (auto-detected from RENDER_EXTERNAL_HOSTNAME on Render when left blank)
# SITE_URL=

# Database (MySQL via XAMPP by default)
# XAMPP ships MariaDB on 127.0.0.1:3306 with user 'root' and an empty password.
DB_NAME=animalbite
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# For hosted/Postgres (e.g. Render) a full URL overrides the MySQL settings above:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Semaphore SMS — RHUDumingag
# Get API key from https://semaphore.co/api  (Login → API)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=RHUDumingag
SEMAPHORE_ENABLED=True
# Set to True to actually send SMS (costs credits). False = dry-run (logs as queued, no credits spent)
# API URL override (leave default)
# SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages

# Optional: customize vaccination days (comma-separated, e.g., 0,3,7,14,28)
# Managed via SystemSetting key 'vaccination_days' or env if you add custom logic
